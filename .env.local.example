NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service-Role-Key (Supabase Dashboard > Project Settings > API) - NIEMALS im Client verwenden
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (per `npx web-push generate-vapid-keys` erzeugen)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:you@example.com

# Geteiltes Secret zwischen Supabase Edge Function (daily-reminder) und /api/push/notify
CRON_SECRET=generate-a-random-string
